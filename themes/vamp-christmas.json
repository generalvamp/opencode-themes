        "900": "#1f0b01"
      },
      "accent": "$hue.orange",
      "interactive": "$hue.orange",
      "neutral": "$hue.gray"
    },
    "categorical": [
      "green",
      "red",
      "orange",
      "blue",
      "purple"
    ],
    "border": {
      "base": "#dcdcdc"
    }
  },
